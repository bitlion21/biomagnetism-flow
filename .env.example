# Frontend runtime mode
# local  = comportamiento actual (solo almacenamiento local)
# hybrid = local + cola de sincronización hacia Netlify Functions/Neon
VITE_DATA_MODE=local

# Si no se define, usa /api (redireccionado a Netlify Functions por netlify.toml)
VITE_SYNC_API_BASE=/api

# Variables solo para Netlify Functions (configurar en Netlify / entorno)
# NEON_DATABASE_URL=postgresql://...
# Alternativa si usas Netlify DB:
# NETLIFY_DATABASE_URL=postgresql://...
